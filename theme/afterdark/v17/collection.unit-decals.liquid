<style>
  .sc-dc{text-align:center;padding-top:2.4rem;padding-bottom:4rem}
  .sc-dc h1{margin:0 0 .4rem}
  .sc-dc .sc-dc__lead{margin:0 0 2.4rem;font-size:1.4rem;letter-spacing:.04em}
  .sc-dc__g{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:2rem 1.6rem;align-items:stretch}
  .sc-dc__g li{margin:0;padding:0;min-width:0}
  .sc-dc__c{display:flex;flex-direction:column;gap:.5rem;text-align:center;height:100%}
  .sc-dc__c img{display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;border:3px solid rgba(var(--color-foreground),.15);background:#e9ebee}
  .sc-dc__c a.sc-dc__img:hover img{border-color:rgba(var(--color-foreground),.6)}
  .sc-dc__c b{font-size:1.4rem;line-height:1.25;margin-top:.4rem}
  .sc-dc__c span.sc-dc__d{font-size:1.2rem;opacity:.8;line-height:1.3}
  .sc-dc__opt{display:flex;gap:.6rem;align-items:flex-start;justify-content:center;font-size:1.1rem;line-height:1.3;text-align:left;margin-top:.4rem;cursor:pointer}
  .sc-dc__opt input{margin:.1rem 0 0;flex:none}
  .sc-dc__em{display:none;width:100%;box-sizing:border-box;padding:.8rem 1rem;font-size:1.2rem;border:1px solid rgba(var(--color-foreground),.4);background:transparent;color:rgb(var(--color-foreground))}
  .sc-dc__em.is-on{display:block}
  .sc-dc__btn{display:block;box-sizing:border-box;text-align:center;padding:1rem 1rem;border-radius:999px;background:#e5261b;color:#fff;font-weight:700;font-size:1.2rem;text-decoration:none;text-transform:uppercase;letter-spacing:.03em;margin-top:auto}
  .sc-dc__btn.ec{background:#e5261b}
  .sc-dc__act{margin-top:auto;display:flex;flex-direction:column;gap:.5rem}
  .sc-dc__msg{font-size:1.1rem;color:#e5261b;min-height:0}
  .sc-dc__qr{display:none;text-align:center;font-size:1.1rem;opacity:.85;margin-top:.8rem;line-height:1.3}
  .sc-dc__q2{display:flex;gap:.8rem;justify-content:center;margin-top:.6rem}
  .sc-dc__q2 span{display:block;font-size:1rem;flex:1;max-width:100px}
  .sc-dc__q2 img{display:block;width:100%;height:auto;margin:0 auto .2rem;border:0;background:#fff;aspect-ratio:auto}
  .sc-dc__btn.soon{opacity:.45;cursor:default}
  .sc-dc__two{display:flex;gap:.6rem}.sc-dc__two .sc-dc__btn{flex:1;margin-top:0;padding:1rem .4rem}
  @media(min-width:990px){.sc-dc__qr{display:block}.sc-dc__g li{display:contents}}
  @media(max-width:989px){.sc-dc__g{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:749px){.sc-dc__g{grid-template-columns:repeat(2,1fr);gap:1.6rem 1rem}.sc-dc__c b{font-size:1.3rem}}
.sc-gf{margin:2.4rem 0 3rem;scroll-margin-top:90px}
  .sc-gf h2{text-align:center;text-transform:uppercase;font-size:1.6rem;margin:0 0 .8rem}
  .sc-gf .sub{text-align:center;opacity:.8;margin:0 auto 2.2rem;max-width:64rem}
  .sc-gf .gg{display:grid;grid-template-columns:repeat(4,1fr);gap:1.6rem;margin:0 0 2.4rem}
  .sc-gf .g{border:1px solid rgba(var(--color-foreground),.2);border-radius:14px;padding:1.2rem;display:flex;flex-direction:column;align-items:center;gap:1rem;text-align:center}
  .sc-gf .g img{width:100%;height:auto;border-radius:10px;background:#fff}
  .sc-gf .btn{display:block;box-sizing:border-box;width:100%;text-align:center;padding:1.2rem 1.6rem;border-radius:999px;background:#e5261b;color:#fff;font-weight:700;font-size:1.2rem;text-decoration:none;text-transform:uppercase;letter-spacing:.03em}
  .sc-gf .gall{text-align:center}.sc-gf .gall .btn{display:inline-block;width:auto;padding:1.6rem 3.6rem}
  @media(max-width:749px){.sc-gf .gg{grid-template-columns:repeat(2,1fr);gap:1rem}}
</style>
