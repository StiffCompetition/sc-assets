<script>
(function(){
  var form=document.getElementById('sc-dc-form');
  document.querySelectorAll('[data-tile]').forEach(function(t){
    var opt=t.querySelector('[data-opt]'),em=t.querySelector('[data-em]'),msg=t.querySelector('[data-msg]');
    if(!opt||!em)return;
    opt.addEventListener('change',function(){em.classList.toggle('is-on',opt.checked);msg.textContent='';if(opt.checked)em.focus();});
    t.querySelectorAll('[data-go]').forEach(function(go){
      go.addEventListener('click',function(e){
        if(!opt.checked||!form)return;
        var v=(em.value||'').trim();
        if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)){e.preventDefault();msg.textContent='Add your email, or untick the box.';em.focus();return;}
        e.preventDefault();
        form.querySelector('[data-form-email]').value=v;
        var href=go.href,done=false,fin=function(){if(!done){done=true;window.location.href=href;}};
        try{fetch('https://n8n-production-afc2.up.railway.app/webhook/sc-roster-signup',{method:'POST',body:new URLSearchParams({email:v})}).then(fin,fin);}catch(x){fin();}
        setTimeout(fin,1800);
      });
    });
  });
})();
</script>
<script>
(function(){
  function save(a){var url=a.getAttribute('href'),name=a.getAttribute('data-name');
    return fetch(url).then(function(r){if(!r.ok)throw 0;return r.blob()}).then(function(b){
      var l=document.createElement('a');l.href=URL.createObjectURL(b);l.download=name;document.body.appendChild(l);l.click();
      setTimeout(function(){URL.revokeObjectURL(l.href);l.remove()},4000);
    }).catch(function(){window.open(url,'_blank')});}
  document.querySelectorAll('a[data-gif]').forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();save(a)})});
  var all=document.getElementById('sc-gif-all');
  if(all)all.addEventListener('click',function(e){e.preventDefault();var list=[].slice.call(document.querySelectorAll('a[data-gif]')),i=0;
    (function next(){if(i>=list.length)return;save(list[i++]).then(function(){setTimeout(next,900)})})();});
})();
</script>
