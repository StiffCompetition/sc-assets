{%- comment -%} Stickers page (Andy, 27 Oct 2026). One page, three one-tap buttons. Assigned to the page /pages/stickers with template suffix "stickers". {%- endcomment -%}
<style>
  .sc-stk{width:100%;box-sizing:border-box;max-width:1100px;margin:0 auto;padding:0 20px 60px}
  .sc-stk .hero{display:block;width:100%;max-width:720px;height:auto;margin:0 auto 28px}
  .sc-stk h1{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .sc-stk .lead{font-size:1.15em;text-align:center;margin:0 auto 36px;max-width:640px;opacity:.9}
  .sc-stk .packs{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:0 0 36px}
  .sc-stk .pack{border:1px solid rgba(var(--color-foreground),.2);border-radius:16px;padding:24px 20px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px}
  .sc-stk .pack h2{font-size:1.25em;margin:0;text-transform:uppercase;letter-spacing:.02em}
  .sc-stk .pack p{margin:0;opacity:.8}
  .sc-stk .btn{display:block;width:100%;box-sizing:border-box;text-align:center;padding:16px 20px;border-radius:999px;background:#e5261b;color:#fff;font-weight:700;font-size:1.1em;text-decoration:none;text-transform:uppercase;letter-spacing:.03em}
  .sc-stk .btn.tg{background:#229ED9}
  .sc-stk .qr{display:none;font-size:.85em;opacity:.8}
  .sc-stk .qr img{width:150px;height:150px;display:block;margin:8px auto 0;background:#fff;padding:6px;border-radius:8px}
  .sc-stk .how{text-align:center;opacity:.8;margin:0 auto 36px;max-width:640px}
  .sc-stk .shop{text-align:center;margin:0 0 36px}
  .sc-stk .shop .btn{display:inline-block;width:auto;padding:16px 36px;background:transparent;color:rgb(var(--color-foreground));border:2px solid currentColor}
  .sc-stk .more{text-align:center;margin:0 0 28px}
  .sc-stk .more a,.sc-stk .share a{text-decoration:underline}
  .sc-stk .share{display:flex;flex-wrap:wrap;gap:16px;justify-content:center;align-items:center;font-size:.95em}
  @media(min-width:900px){.sc-stk .qr{display:block}}
  @media(max-width:899px){.sc-stk .packs{grid-template-columns:1fr}}
</style>
<div class="sc-stk">
  <img class="hero" src="{{ 'sc-stickers-phone.png' | asset_url }}" alt="Stiff Competition stickers in a WhatsApp chat" width="720" height="720" loading="eager">
  <h1>Drop them in any chat</h1>
  <p class="lead">Six characters, every mood you've got. Free on WhatsApp and Telegram, Android and iPhone.</p>

  <div class="packs">
    <div class="pack">
      <h2>WhatsApp &middot; Pack 1</h2>
      <p>30 stickers: the reactions.</p>
      <a class="btn" href="https://getstickerpack.com/s/137998?key=4jxn57">Add to WhatsApp</a>
      <div class="qr">On a computer? Scan with your phone<img src="{{ 'sc-stickers-qr-pack1.png' | asset_url }}" alt="QR code for WhatsApp Pack 1" width="150" height="150" loading="lazy"></div>
    </div>
    <div class="pack">
      <h2>WhatsApp &middot; Pack 2</h2>
      <p>25 stickers: the moods.</p>
      <a class="btn" href="https://getstickerpack.com/s/138000?key=50te6m">Add to WhatsApp</a>
      <div class="qr">On a computer? Scan with your phone<img src="{{ 'sc-stickers-qr-pack2.png' | asset_url }}" alt="QR code for WhatsApp Pack 2" width="150" height="150" loading="lazy"></div>
    </div>
    <div class="pack">
      <h2>Telegram</h2>
      <p>The whole cast in one set.</p>
      <a class="btn tg" href="https://t.me/addstickers/stiffcompetition">Add to Telegram</a>
      <div class="qr">On a computer? Scan with your phone<img src="{{ 'sc-stickers-qr-telegram.png' | asset_url }}" alt="QR code for the Telegram sticker set" width="150" height="150" loading="lazy"></div>
    </div>
  </div>

  <p class="how">On your phone, tap a button. WhatsApp packs open in the free Sticker Maker app, which adds them to WhatsApp. Telegram adds them in one tap.</p>

  <p class="shop"><a class="btn" href="/">Visit the Stiff Competition shop</a></p>

  <p class="more">Want all 54 as images for Instagram, Discord and iMessage? <a href="/products/the-full-cast-stiff-competition-sticker-set-free-download">Download the full set</a>, free.</p>

  <div class="share">
    <span>Send this page to someone who needs it:</span>
    <a href="https://wa.me/?text=Free%20Stiff%20Competition%20stickers%3A%20https%3A%2F%2Fstiffcompetition.shop%2Fpages%2Fstickers">WhatsApp</a>
    <a href="https://t.me/share/url?url=https%3A%2F%2Fstiffcompetition.shop%2Fpages%2Fstickers&text=Free%20Stiff%20Competition%20stickers">Telegram</a>
    <a href="https://www.instagram.com/stiffcompetition_hq/">Instagram</a>
  </div>
</div>
