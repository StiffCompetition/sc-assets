{%- comment -%} The Stiff Diaries page (page.handle == 'stiff-diaries'). Newest entry first: add a new block at the top of the entries area. {%- endcomment -%}
<style id="sdp-style">
.sdp{--y:#ffe500;--r:#ed1c24;--k:#15181c;font-family:inherit;color:var(--k);margin:0 0 30px}
.sdp *{box-sizing:border-box}
.sdp-intro{background:var(--y);background-image:radial-gradient(#e6cf00 2.2px,transparent 2.7px);background-size:16px 16px;border:4px solid var(--k);box-shadow:6px 6px 0 var(--k);padding:18px 18px 16px;margin:6px 0 26px;transform:rotate(-.6deg)}
.sdp-intro p{margin:0;font-size:19px;line-height:1.3;font-weight:700}
.sdp-intro span{display:block;margin-top:8px;font-size:15px;font-weight:400}
.sdp-entry{display:grid;grid-template-columns:minmax(0,340px) minmax(0,1fr);gap:26px;align-items:start;margin:0 0 34px}
.sdp-vid{position:relative;border:4px solid var(--k);box-shadow:6px 6px 0 var(--k);background:var(--k);transform:rotate(-1deg);line-height:0}
.sdp-vid video{width:100%;height:auto;display:block;aspect-ratio:9/16;background:#000}
.sdp-tag{display:block;width:fit-content;background:var(--y);color:var(--k);border:3px solid var(--k);box-shadow:3px 3px 0 var(--k);padding:5px 10px;font-weight:700;font-size:13px;line-height:1.2;transform:rotate(-2deg);margin:0 0 12px;letter-spacing:.04em}
.sdp-h{margin:0 0 10px;font-size:26px;line-height:1.1}
.sdp-page{background:#fff;border:3px solid var(--k);box-shadow:4px 4px 0 var(--k);padding:14px 16px;font-size:18px;line-height:1.4}
.sdp-page p{margin:0 0 4px}
.sdp-q{position:relative;background:#fff;border:3px solid var(--k);box-shadow:4px 4px 0 var(--k);padding:10px 14px;font-size:20px;font-weight:700;line-height:1.25;margin:22px 0 14px}
.sdp-q::before{content:"";position:absolute;left:26px;top:-12px;width:14px;height:14px;background:#fff;border-left:3px solid var(--k);border-top:3px solid var(--k);transform:rotate(45deg)}
.sdp-btns{display:flex;flex-wrap:wrap;gap:12px 14px}
.sdp-btns a{display:inline-block;background:var(--r);color:#fff;border:3px solid var(--k);box-shadow:4px 4px 0 var(--k);padding:7px 13px;text-decoration:none;font-weight:700;transition:transform .09s ease,box-shadow .09s ease}
.sdp-btns a:active{transform:translate(4px,4px);box-shadow:0 0 0 var(--k)}
.sdp-six{margin:8px 0 0}
.sdp-six h2{display:inline-block;background:#fff;border:3px solid var(--k);box-shadow:4px 4px 0 var(--k);padding:8px 14px;margin:0 0 16px;font-size:22px;line-height:1.15}
.sdp-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.sdp-c{display:block;background:#fff;border:3px solid var(--k);box-shadow:4px 4px 0 var(--k);padding:12px;text-decoration:none;color:var(--k);transition:transform .09s ease,box-shadow .09s ease}
.sdp-c:active{transform:translate(4px,4px);box-shadow:0 0 0 var(--k)}
.sdp-c b{display:block;font-size:17px;line-height:1.15}
.sdp-c i{display:block;font-style:normal;font-size:14px;margin-top:3px}
.sdp-c em{display:block;font-style:normal;font-size:12px;font-weight:700;margin-top:8px;color:var(--r);letter-spacing:.04em}
@media(max-width:749px){.sdp-entry{grid-template-columns:1fr;gap:20px}.sdp-vid{max-width:360px;margin:0 auto;width:100%}.sdp-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.sdp-h{font-size:22px}.sdp-intro p{font-size:17px}}
</style>
