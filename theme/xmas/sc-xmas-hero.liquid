<style>
[id$='__hero_video']{display:none!important}
.scxh{display:flex;flex-direction:column;align-items:center;padding:22px 16px 8px}
.scxh__win{position:relative;aspect-ratio:9/16;width:min(100%,calc(min(86svh,760px)*.5625));background:#000;border-radius:10px;box-shadow:0 10px 40px rgba(0,0,0,.45);overflow:visible}
.scxh__v{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:10px;display:block;background:#000}
.scxh__snd{position:absolute;left:10px;bottom:10px;height:44px;padding:0 16px;border:0;border-radius:22px;background:rgba(0,0,0,.65);color:#fff;font-size:1.2rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;z-index:2}
.scxh__pp{position:absolute;right:10px;bottom:10px;width:44px;height:44px;border:0;border-radius:50%;background:rgba(0,0,0,.65);color:#fff;font-size:1.6rem;cursor:pointer;z-index:2}
.scxh__btns{display:flex;gap:12px;justify-content:center;width:100%;max-width:520px;padding:18px 0 10px}
.scxh__btns a{flex:1 1 0;min-width:0;min-height:4.8rem;display:flex;align-items:center;justify-content:center;text-align:center;text-decoration:none;font-weight:700;letter-spacing:.05em;text-transform:uppercase;border-radius:999px;font-size:1.3rem;padding:1rem 1.2rem;line-height:1.25}
.scxh__btns .x{background:#e5261b;color:#fff;font-size:1.5rem;flex:1.5 1 0}
.scxh__btns .y{background:#334fb4;color:#fff}
</style>
<div class="scxh">
  <div class="scxh__win">
    <video class="scxh__v" muted loop playsinline preload="metadata" poster="{{ 'sc-xmas-hero-poster.jpg' | asset_url }}" aria-label="Wishing everyone a warm and wonderful Christmas from Stiff Competition"><source src="{{ 'sc-xmas-hero-v6.mp4' | asset_url }}" type="video/mp4"></video>
    <button type="button" class="scxh__snd" aria-pressed="false">Tap for sound</button>
    <button type="button" class="scxh__pp" aria-label="Pause video">&#10074;&#10074;</button>
  </div>
  <div class="scxh__btns"><a class="x" href="/collections/christmas-2026">Shop Christmas 2026</a><a class="y" href="/collections/all">Shop all merch</a></div>
</div>
<script>
(function(){
  var r=document.currentScript.previousElementSibling;if(!r)return;
  var v=r.querySelector('video'),s=r.querySelector('.scxh__snd'),p=r.querySelector('.scxh__pp');
  v.muted=true;
  function sync(){s.textContent=v.muted?'Tap for sound':'Sound on';s.setAttribute('aria-pressed',v.muted?'false':'true');p.innerHTML=v.paused?'&#9654;':'&#10074;&#10074;';p.setAttribute('aria-label',v.paused?'Play video':'Pause video');}
  s.addEventListener('click',function(){v.muted=!v.muted;if(!v.muted&&v.paused){var q=v.play();if(q&&q.catch)q.catch(sync);}sync();});
  p.addEventListener('click',function(){if(v.paused){var q=v.play();if(q&&q.catch)q.catch(sync);}else{v.pause();}sync();});
  v.addEventListener('play',sync);v.addEventListener('pause',sync);
  var rm=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!rm){var q=v.play();if(q&&q.catch)q.catch(sync);}
  sync();
  /* old hero clip moves down into LATEST TRANSMISSION as its first clip */
  function mv(){try{
    var old=document.querySelector("[id$='__hero_video'] video"),tr=document.querySelector('.ltr__track');
    if(old&&tr){
      var t=document.createElement('div');t.className='ltr__tile';
      var ov=document.createElement('video');ov.controls=true;ov.playsInline=true;ov.preload='none';ov.poster=old.getAttribute('poster')||'';
      old.querySelectorAll('source').forEach(function(s){ov.appendChild(s.cloneNode(true));});
      t.appendChild(ov);tr.insertBefore(t,tr.firstChild);
      ov.addEventListener('play',function(){document.querySelectorAll('.scxh__v,.ltr__tile video').forEach(function(o){if(o!==ov&&!o.paused)o.pause();});});
    }
  }catch(e){}}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mv);else mv();
})();
</script>
