<style>
.scx-lights{height:0;margin:0;position:relative;z-index:30;pointer-events:none}
.scx-lights i{display:block;position:absolute;left:0;right:0;top:-34px;height:40px;-webkit-mask-image:linear-gradient(90deg,#000 0,#000 28%,transparent 36%,transparent 64%,#000 72%,#000 100%);mask-image:linear-gradient(90deg,#000 0,#000 28%,transparent 36%,transparent 64%,#000 72%,#000 100%);background:url('data:image/svg+xml;base64,') repeat-x left top;animation:scxg 3.2s ease-in-out infinite alternate}
@keyframes scxg{from{opacity:.82}to{opacity:1}}
@media(prefers-reduced-motion:reduce){.scx-lights i{animation:none}}
@media(max-width:749px){.scx-lights i{top:-26px;height:30px;background-size:90px 30px}}
.scx-snow{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:6}
</style>
<div class="scx-lights" aria-hidden="true"><i></i></div>
<canvas class="scx-snow" aria-hidden="true"></canvas>
<script>
(function(){
  var c=document.querySelector('.scx-snow');if(!c)return;
  try{if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){c.remove();return;}}catch(e){}
  var x=c.getContext('2d'),w,h,f=[],n=window.innerWidth<750?26:54;
  function size(){w=c.width=window.innerWidth;h=c.height=window.innerHeight;}
  size();window.addEventListener('resize',size);
  for(var i=0;i<n;i++)f.push({x:Math.random()*w,y:Math.random()*h,r:1.6+Math.random()*3,s:.4+Math.random()*.9,d:Math.random()*6});
  function tick(){
    x.clearRect(0,0,w,h);
    for(var i=0;i<f.length;i++){var o=f[i];o.y+=o.s;o.d+=.012;o.x+=Math.sin(o.d)*.5;
      if(o.y>h+6){o.y=-6;o.x=Math.random()*w;}
      x.beginPath();x.arc(o.x,o.y,o.r,0,6.283);x.fillStyle='rgba(255,255,255,.95)';x.shadowColor='rgba(120,150,200,.8)';x.shadowBlur=4;x.fill();}
    /* no snow over any video */
    x.save();x.globalCompositeOperation='destination-out';x.shadowBlur=0;
    document.querySelectorAll('video').forEach(function(v){var r=v.getBoundingClientRect();if(r.bottom>0&&r.top<h)x.fillRect(r.left-12,r.top-12,r.width+24,r.height+24);});
    x.restore();
    requestAnimationFrame(tick);
  }
  tick();
})();
</script>
