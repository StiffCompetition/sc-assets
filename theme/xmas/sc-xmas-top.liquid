<style>
.scx-str{position:absolute;left:0;right:0;top:0;height:32px;pointer-events:none;z-index:6;overflow:hidden}
.scx-str svg{display:block;width:100%;height:32px}
.scx-str .gl{animation:scxt 1.7s ease-in-out infinite alternate}
.scx-str .bd{animation:scxb 1.7s ease-in-out infinite alternate}
.scx-str .k1,.scx-str .k1b{animation-delay:-.4s}.scx-str .k2,.scx-str .k2b{animation-delay:-.9s}.scx-str .k3,.scx-str .k3b{animation-delay:-1.3s}.scx-str .k4,.scx-str .k4b{animation-delay:-.7s}
@keyframes scxt{from{opacity:.25}to{opacity:1}}
@keyframes scxb{from{opacity:.72}to{opacity:1}}
@media(prefers-reduced-motion:reduce){.scx-str .gl,.scx-str .bd{animation:none}}
.scx-snow{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:6}
</style>
<script>
(function(){
  var C=['#ff2d3d','#ffc21a','#22c55e','#2f7cff','#ff4fb0'];
  function build(host){
    var W=host.clientWidth||window.innerWidth,m=W<750,sc=m?.9:1.15,span=138*sc,n=Math.ceil(W/span)+1,sag=4*sc;
    var d='<defs>';
    C.forEach(function(c,i){
      d+='<radialGradient id="scxg'+i+'"><stop offset="0" stop-color="'+c+'" stop-opacity=".9"/><stop offset=".45" stop-color="'+c+'" stop-opacity=".35"/><stop offset="1" stop-color="'+c+'" stop-opacity="0"/></radialGradient>';
      d+='<radialGradient id="scxb'+i+'" cx=".35" cy=".3" r=".85"><stop offset="0" stop-color="#fff"/><stop offset=".3" stop-color="'+c+'"/><stop offset="1" stop-color="'+c+'" stop-opacity=".85"/></radialGradient>';
    });
    d+='</defs>';
    var wire='M-2 1',b='',k=0;
    for(var j=0;j<n;j++){
      var x0=j*span;
      wire+=' Q'+(x0+span/2)+' '+(1+2*sag)+' '+(x0+span)+' 1';
      [1/6,1/2,5/6].forEach(function(t){
        var x=x0+span*t,y=1+4*sag*t*(1-t),i=k%5;k++;
        b+='<g transform="translate('+x.toFixed(1)+' '+y.toFixed(1)+') scale('+sc+')">'
         +'<circle class="gl k'+i+'" cx="0" cy="10" r="11" fill="url(#scxg'+i+')"/>'
         +'<rect x="-2.3" y="-.5" width="4.6" height="4.2" rx="1" fill="#2b2b2b"/><rect x="-2.3" y="1" width="4.6" height=".8" fill="#555"/>'
         +'<path class="bd k'+i+'b" d="M0 3.4 C-5 5.2 -4.8 14.5 0 16.2 C4.8 14.5 5 5.2 0 3.4Z" fill="url(#scxb'+i+')"/>'
         +'<ellipse cx="-1.6" cy="8" rx=".9" ry="2.6" fill="#fff" opacity=".85"/></g>';
      });
    }
    host.innerHTML='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 '+W+' 32" width="'+W+'" height="32" preserveAspectRatio="xMinYMin slice">'+d+'<path d="'+wire+'" fill="none" stroke="#14301b" stroke-width="1.7"/><path d="'+wire+'" fill="none" stroke="#2f6a3d" stroke-width=".6" opacity=".7"/>'+b+'</svg>';
  }
  function go(){
    var hd=document.querySelector('header'),sec=hd&&hd.closest('.shopify-section');
    if(!sec||document.querySelector('.scx-str'))return;
    var h=document.createElement('div');h.className='scx-str';h.setAttribute('aria-hidden','true');sec.appendChild(h);build(h);
    var t;window.addEventListener('resize',function(){clearTimeout(t);t=setTimeout(function(){build(h)},150)});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
})();
</script>
<canvas class="scx-snow" aria-hidden="true"></canvas>
<script>
(function(){
  var c=document.querySelector('.scx-snow');if(!c)return;
  try{if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){c.remove();return;}}catch(e){}
  var x=c.getContext('2d'),w,h,f=[],n=window.innerWidth<750?26:54;
  function size(){w=c.width=window.innerWidth;h=c.height=window.innerHeight;}
  size();window.addEventListener('resize',size);
  for(var i=0;i<n;i++)f.push({x:Math.random()*w,y:Math.random()*h,r:1.6+Math.random()*3,s:.4+Math.random()*.9,d:Math.random()*6});
  function tick(){
    x.clearRect(0,0,w,h);
    for(var i=0;i<f.length;i++){var o=f[i];o.y+=o.s;o.d+=.012;o.x+=Math.sin(o.d)*.5;
      if(o.y>h+6){o.y=-6;o.x=Math.random()*w;}
      x.beginPath();x.arc(o.x,o.y,o.r,0,6.283);x.fillStyle='rgba(255,255,255,.95)';x.shadowColor='rgba(120,150,200,.8)';x.shadowBlur=4;x.fill();}
    /* no snow over any video */
    x.save();x.globalCompositeOperation='destination-out';x.shadowBlur=0;
    document.querySelectorAll('video').forEach(function(v){var r=v.getBoundingClientRect();if(r.bottom>0&&r.top<h)x.fillRect(r.left-12,r.top-12,r.width+24,r.height+24);});
    x.restore();
    requestAnimationFrame(tick);
  }
  tick();
})();
</script>
<script>
(function(){
  if(location.pathname.replace(/\/$/,'')!=='/pages/merch')return;
  function add(){
    var ul=document.querySelector('.collection-list');
    if(!ul||document.getElementById('sc-xmas-card'))return;
    var first=ul.querySelector('li.collection-list__item');if(!first)return;
    var li=first.cloneNode(true);li.id='sc-xmas-card';li.style.setProperty('--animation-order','0');
    li.querySelectorAll('a').forEach(function(a){a.setAttribute('href','/collections/christmas-2026');a.childNodes.forEach(function(n){if(n.nodeType===3){n.textContent='Christmas 2026';}});});
    var im=li.querySelector('img');
    if(im){im.removeAttribute('srcset');im.src='https://cdn.shopify.com/s/files/1/0661/7428/7966/files/pics67_1793980363277_pic_01_main_black_1847c3d4-6153-444e-853a-f2fffbb73181.jpg?v=1793981446&width=1500';im.alt='Christmas 2026 t-shirts';im.width=1500;im.height=1500;}
    li.querySelectorAll('.card__caption').forEach(function(p){var ic=p.querySelector('.icon-wrap');p.textContent='Funny Christmas t-shirts. Six characters, six Santa hats.';if(ic){p.appendChild(ic);}});
    ul.insertBefore(li,ul.firstElementChild);
    ul.className=ul.className.replace(/collection-list--\d+-items/,function(m){return 'collection-list--'+(parseInt(m.match(/\d+/)[0],10)+1)+'-items';});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',add);else add();
})();
</script>
