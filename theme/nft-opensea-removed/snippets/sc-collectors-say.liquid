{%- comment -%}
  Collectors say. Reads approved quotes from the shop metafield stiff.collector_quotes
  (JSON list: name, country, product, quote, rating, handle, title, type, image, similar[]), written from the SC Collector Quotes table.
  mode 'all'  : strip of three quotes at a time (rotating start) plus link to the Collectors say page.
  mode 'one'  : a single quote picked at random in the browser (product pages).
  mode 'page' : every quote as a card, newest first, with picture, shop button, or Collected stamp and similar artworks for sold NFTs (sold NFT picture is not a link).
  Every quote shows its 1 to 5 star rating when one is stored.
  Matching: product pages show only NFT quotes on NFT products and only merch quotes on merch products; the Digital Mint page shows only NFT quotes; every other place shows all quotes. Nothing shows when no quote matches.
  Shop Sales Review Playbook, section 3.7; stars 27 Oct 2026.
{%- endcomment -%}
{%- assign quotes = shop.metafields.stiff.collector_quotes.value -%}
{%- assign m = mode | default: 'all' -%}
{%- assign kind = '' -%}
{%- if m == 'one' and product -%}{%- if product.type == 'NFT' -%}{%- assign kind = 'nft' -%}{%- else -%}{%- assign kind = 'merch' -%}{%- endif -%}{%- endif -%}
{%- if m == 'all' -%}{%- assign kind = 'merch' -%}{%- endif -%}
{%- if quotes and kind == 'nft' -%}
  {%- assign quotes = quotes | where: 'type', 'NFT' -%}
{%- elsif quotes and kind == 'merch' -%}
  {%- assign keep = '' | split: '' -%}
  {%- for q in quotes -%}{%- if q.type != 'NFT' -%}{%- assign one = quotes | where: 'handle', q.handle -%}{%- assign keep = keep | concat: one -%}{%- endif -%}{%- endfor -%}
  {%- assign quotes = keep -%}
{%- endif -%}
{%- if quotes and quotes.size > 0 -%}
<style>
.sc-say{margin:1.6rem 0}.sc-say__h{margin:0 0 .8rem;font-size:1.2rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7}
.sc-say__g{list-style:none;margin:0;padding:0;display:flex;gap:1.2rem}
.sc-say__c{flex:1 1 0;min-width:0;border-left:4px solid #ed1c24;padding:.2rem 0 .2rem 1.2rem}
.sc-say__c blockquote{margin:0;font-size:1.5rem;line-height:1.45;font-style:italic}
.sc-say__c cite{display:block;margin-top:.5rem;font-size:1.2rem;font-style:normal;letter-spacing:.04em;opacity:.75}
.sc-say__s{display:block;margin:0 0 .4rem;font-size:1.6rem;line-height:1;letter-spacing:.12em;color:#ed1c24}
.sc-say--all .sc-say__h{text-align:center;font-size:1.4rem;opacity:1;font-weight:700}
.sc-say--all .sc-say__g{justify-content:center}.sc-say--all .sc-say__c{flex:0 1 36rem}
.sc-say__more{display:block;text-align:center;margin-top:1.2rem;font-size:1.3rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:#ed1c24;text-decoration:underline;text-underline-offset:.3rem}
@media(max-width:749px){.sc-say--all .sc-say__g{overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding-bottom:.6rem;justify-content:flex-start}.sc-say--all .sc-say__c{flex:0 0 82%;scroll-snap-align:start}}
{%- if m == 'page' -%}
.sc-sayp{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:2.4rem;align-items:stretch}
.sc-sayp__c{border:1px solid rgba(var(--color-foreground),.15);border-left:4px solid #ed1c24;padding:1.4rem;display:flex;flex-direction:column;gap:1rem;min-width:0}
.sc-sayp__pic{position:relative;display:block;aspect-ratio:1/1;background:#e9ebee;overflow:hidden;flex:0 0 auto}
.sc-sayp__pic img{display:block;width:100%;height:100%;object-fit:cover}
.sc-sayp__stamp{position:absolute;top:.8rem;right:.8rem;transform:rotate(8deg);border:3px solid #ed1c24;color:#ed1c24;background:rgba(255,255,255,.92);padding:.3rem .8rem;font-size:1.2rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;display:flex;align-items:center;gap:.4rem}
.sc-sayp__stamp svg{width:1.3rem;height:1.3rem;fill:#ed1c24}
.sc-sayp__c blockquote{flex:1 0 auto;margin:0;padding:0;border:0;background:none;font-size:1.5rem;line-height:1.45;font-style:italic}
.sc-sayp__c blockquote::before,.sc-sayp__c blockquote::after{content:none}
.sc-sayp__c cite{font-size:1.2rem;font-style:normal;letter-spacing:.04em;opacity:.75;min-height:2.4em}
.sc-sayp__btn{display:inline-block;align-self:flex-start;background:#ed1c24;color:#fff;padding:1rem 1.8rem;font-size:1.3rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;margin-top:auto}
.sc-sayp__btn:hover{background:#c4151b}
.sc-sayp__sim{margin-top:auto}
.sc-sayp__sim h3{margin:0 0 .6rem;font-size:1.2rem;letter-spacing:.1em;text-transform:uppercase;opacity:.75}
.sc-sayp__sim ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}
.sc-sayp__sim a{display:block;text-decoration:none;color:rgb(var(--color-foreground));font-size:1.1rem;line-height:1.3}
.sc-sayp__sim img{display:block;width:100%;aspect-ratio:1/1;object-fit:cover;background:#e9ebee;border:2px solid rgba(var(--color-foreground),.15)}
.sc-sayp__sim a:hover img{border-color:#ed1c24}
.sc-sayp__sim span{display:block;margin-top:.3rem}
@media(max-width:989px){.sc-sayp{grid-template-columns:repeat(2,1fr)}}
@media(max-width:749px){.sc-sayp{grid-template-columns:1fr}}
{%- endif -%}
</style>
{%- if m == 'page' -%}
<ul class="sc-sayp">
  {%- assign rev = quotes | reverse -%}
  {%- for i in rev -%}
  {%- assign stars = '' -%}{%- if i.rating and i.rating > 0 -%}{%- capture stars -%}<span class="sc-say__s" role="img" aria-label="{{ i.rating }} out of 5 stars">{%- for n in (1..5) -%}{%- if n <= i.rating -%}&#9733;{%- else -%}&#9734;{%- endif -%}{%- endfor -%}</span>{%- endcapture -%}{%- endif -%}
  <li class="sc-sayp__c">
    {%- if i.image != blank and i.handle != blank -%}
      {%- if i.type == 'NFT' -%}
    <div class="sc-sayp__pic"><img src="{{ i.image }}&width=600" alt="{{ i.title | escape }}" loading="lazy">
      <span class="sc-sayp__stamp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7.3L12 17.8 5.7 21.5l1.7-7.3L2 9.5l7.1-.6z"/></svg>Collected</span>
    </div>
      {%- else -%}
    <a class="sc-sayp__pic" href="/products/{{ i.handle }}"><img src="{{ i.image }}&width=600" alt="{{ i.title | escape }}" loading="lazy"></a>
      {%- endif -%}
    {%- endif -%}
    {{ stars }}<blockquote>&ldquo;{{ i.quote | escape }}&rdquo;</blockquote>
    <cite>{{ i.name | escape }}, {{ i.country | escape }} &middot; {{ i.product | escape }}</cite>
    {%- if i.type == 'NFT' -%}
      {%- if i.similar and i.similar.size > 0 -%}
      <div class="sc-sayp__sim"><h3>Similar artworks still available</h3>
        <ul>{%- for s in i.similar -%}<li><a href="/products/{{ s.handle }}"><img src="{{ s.image }}&width=240" alt="{{ s.title | escape }}" loading="lazy"><span>{{ s.title | escape }}</span></a></li>{%- endfor -%}</ul>
      </div>
      {%- endif -%}
    {%- elsif i.handle != blank -%}
      <a class="sc-sayp__btn" href="/products/{{ i.handle }}">Shop this</a>
    {%- endif -%}
  </li>
  {%- endfor -%}
</ul>
{%- else -%}
<div class="sc-say sc-say--{{ m }}">
  <p class="sc-say__h">Collectors say</p>
  <ul class="sc-say__g">
  {%- for i in quotes -%}
    {%- assign stars = '' -%}{%- if i.rating and i.rating > 0 -%}{%- capture stars -%}<span class="sc-say__s" role="img" aria-label="{{ i.rating }} out of 5 stars">{%- for n in (1..5) -%}{%- if n <= i.rating -%}&#9733;{%- else -%}&#9734;{%- endif -%}{%- endfor -%}</span>{%- endcapture -%}{%- endif -%}
    <li class="sc-say__c{% if forloop.index > 3 %} sc-say__x{% endif %}">{{ stars }}<blockquote>&ldquo;{{ i.quote | escape }}&rdquo;</blockquote><cite>{{ i.name | escape }}, {{ i.country | escape }} &middot; {{ i.product | escape }}</cite></li>
  {%- endfor -%}
  </ul>
  {%- if m == 'all' -%}<a class="sc-say__more" href="/pages/collectors-say">Read all collector reports</a>{%- endif -%}
</div>
{%- if m == 'all' -%}
<style>.sc-say--all .sc-say__x{display:none}</style>
<script>(function(){var g=document.querySelector('.sc-say--all .sc-say__g');if(!g)return;var c=g.children,n=c.length;if(n<4)return;var s=Math.floor(Math.random()*n);for(var i=0;i<n;i++){var on=((i-s+n)%n)<3;c[i].style.display=on?'block':'none';}})();</script>
{%- endif -%}
{%- if m == 'one' -%}
<script>(function(){var g=document.querySelector('.sc-say--one .sc-say__g');if(!g)return;var c=g.children;if(c.length<2)return;var k=Math.floor(Math.random()*c.length);for(var i=0;i<c.length;i++){if(i!==k)c[i].style.display='none';}})();</script>
{%- endif -%}
{%- endif -%}
{%- endif -%}
