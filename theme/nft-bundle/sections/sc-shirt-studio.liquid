{%- comment -%}
  SC - YOUR T-SHIRT (26 Oct 2026, Andy's design: same layout as every other product). Works on the NFT Shirt product page only when the
  link carries ?nft=<nft handle> (the Add T-shirt tile on an NFT page sends the shopper here). It draws nothing of its own:
  it fills the standard product page with the shopper's artwork.
  - Pictures: the three designs drawn on the garment photo of the chosen colour become the product gallery (and its click-to-zoom view).
    The print pictures are the real designs from the shirt maker (n8n webhook sc-shirt-preview, SC - Shirt Preview), with YOUR NAME HERE.
  - "Choose your design" is a pill picker above Colour and Size, in the same style.
  - Price shows the bundle price for the NFT's grade; the standard Add to cart adds the NFT and the T-shirt together.
  Garment photos: assets/sc-tshirt-<colour>.jpg (Gelato's photo per colour). Prices: snippets/sc-bundle-data.liquid.
  Without ?nft= the page is the normal NFT Shirt page.
{%- endcomment -%}
{%- if product.handle == 'nft-shirt' -%}
{%- render 'sc-bundle-data' -%}
<style>
body.sc-studio-on .sc-pair{display:none!important;}
body.sc-studio-on .product-form__buttons{display:block!important;}
body.sc-studio-on .product-form__input--pill input.sc-off+label{opacity:.35;pointer-events:none;text-decoration:line-through;}
.sc-studio-line{font-size:1.3rem;margin:0 0 14px;}
.sc-studio-line a{text-decoration:underline;text-underline-offset:3px;}
.sc-studio-wait{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.3rem;background:rgba(var(--color-background),.6);}
</style>
<script>
(function(){
  var q=new URLSearchParams(location.search), h=q.get('nft'); if(!h){return;}
  var B=window.SC_BUNDLE, money=window.scMoney, bp=window.scBundlePrice; if(!B||!B.shirt||!B.shirt.available){return;}
  var HOOK='https://n8n-production-afc2.up.railway.app/webhook/sc-shirt-preview';
  var GARMENT={{ 'sc-tshirt-black.jpg' | asset_url | json }};
  var THEMES=[['registered_owner','Registered owner'],['brag_stats','Brag stats'],['dog_tag','Pocket dog tag']];
  /* Print box on Gelato's 2048 px garment photo (same scene for every colour). */
  var PX={x:709/2048,y:532/2048,w:643/2048};
  function garmentUrl(colour){ return GARMENT.replace('sc-tshirt-black.jpg','sc-tshirt-'+String(colour||'black').toLowerCase().replace(/\s+/g,'-')+'.jpg'); }
  function load(src){ return new Promise(function(res,rej){ var im=new Image(); im.crossOrigin='anonymous'; im.onload=function(){res(im);}; im.onerror=function(){rej(src);}; im.src=src; }); }
  var prints={}, garments={}, n=null, design='registered_owner', ready=false;
  function colourNow(){ var r=document.querySelector('variant-selects input[type=radio][name^="Colour"]:checked'); return r?r.value:'Black'; }
  function sizeNow(){ var r=document.querySelector('variant-selects input[type=radio][name^="Size"]:checked'); return r?r.value:''; }
  function getGarment(colour){ var k=colour.toLowerCase(); if(!garments[k]){ garments[k]=load(garmentUrl(colour)).catch(function(){ return load(GARMENT); }); } return garments[k]; }
  function getPrint(theme){ if(!prints[theme]){ prints[theme]=fetch(HOOK,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({theme:theme,image_url:n.image,title:n.title,character:n.character,stats:n.stats,width:900})}).then(function(r){return r.json();}).then(function(j){ if(!j.url){throw 0;} return load(j.url); }); } return prints[theme]; }
  function compose(theme,colour){ return Promise.all([getGarment(colour),getPrint(theme)]).then(function(a){ var g=a[0],p=a[1]; var S=1600; var c=document.createElement('canvas'); c.width=S; c.height=S; var x=c.getContext('2d'); x.drawImage(g,0,0,S,S); var w=PX.w*S; x.drawImage(p,PX.x*S,PX.y*S,w,w*p.height/p.width); return c.toDataURL('image/jpeg',.86); }); }
  function setMedia(i,dataUrl,alt){ var items=document.querySelectorAll('.product__media-item'); var it=items[i]; if(!it){return;} it.querySelectorAll('img').forEach(function(im){ im.removeAttribute('srcset'); im.removeAttribute('sizes'); im.src=dataUrl; im.alt=alt; }); var mid=it.getAttribute('data-media-id'); document.querySelectorAll('product-modal img').forEach(function(im){ var p=im.closest('[data-media-id]'); if(p&&p.getAttribute('data-media-id')===mid){ im.removeAttribute('srcset'); im.removeAttribute('sizes'); im.src=dataUrl; im.alt=alt; } }); }
  function paintAll(){ var colour=colourNow(); THEMES.forEach(function(t,i){ compose(t[0],colour).then(function(d){ setMedia(i,d,n.title+' on a '+colour+' T-shirt, '+t[1]+' design'); }).catch(function(){}); }); }
  function showDesign(){ var i=0; THEMES.forEach(function(t,k){ if(t[0]===design){i=k;} }); var it=document.querySelectorAll('.product__media-item')[i]; if(it){ it.scrollIntoView({block:'nearest',behavior:'smooth'}); } }
  function allowed(colour){ return design==='dog_tag' || B.darkColours.indexOf(colour)>-1; }
  function applyColourRules(){ document.querySelectorAll('variant-selects input[type=radio][name^="Colour"]').forEach(function(r){ r.classList.toggle('sc-off',!allowed(r.value)); }); if(!allowed(colourNow())){ var b=document.querySelector('variant-selects input[type=radio][name^="Colour"][value="Black"]'); if(b){ b.click(); } } }
  function price(){ var v=B.shirt.variants[colourNow()+'|'+sizeNow()]; var g=window.scGradeOf([n.grade]); var el=document.querySelector('.price .price-item--regular'); if(!v||!el){return;} var box=el.closest('.price__container'); if(g){ el.innerHTML=money(bp(v.price,g.key))+' <s style="opacity:.6;font-weight:400">'+money(v.price)+'</s>'; var s=document.getElementById('sc-studio-line'); if(s){ s.innerHTML='For <b>'+n.title+'</b>'+(n.character?' ('+n.character+')':'')+'. '+B.pct[g.key]+'% off with this artwork, applied in your cart. <a href="'+n.url+'">Change artwork</a>'; } } }
  function buildDesignPicker(){ var vs=document.querySelector('variant-selects'); if(!vs){return;} var fs=document.createElement('fieldset'); fs.className='js product-form__input product-form__input--pill'; fs.id='sc-design-picker'; fs.innerHTML='<legend class="form__label">Choose your design</legend>'+THEMES.map(function(t,i){ return '<input type="radio" id="sc-design-'+i+'" name="sc-design" value="'+t[0]+'"'+(t[0]===design?' checked':'')+'><label for="sc-design-'+i+'">'+t[1]+'</label>'; }).join(''); vs.parentNode.insertBefore(fs,vs); var line=document.createElement('p'); line.className='sc-studio-line'; line.id='sc-studio-line'; vs.parentNode.insertBefore(line,vs); fs.addEventListener('change',function(e){ if(e.target.name==='sc-design'){ design=e.target.value; applyColourRules(); showDesign(); } }); }
  function nftPos(){ return fetch('/cart.js',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(c){var k=0;(c.items||[]).forEach(function(i){if(i.product_type==='NFT'){k+=parseInt(i.quantity,10)||0;}});return k+1;}).catch(function(){return 1;}); }
  function hookAdd(){ document.addEventListener('click',function(e){ var b=e.target.closest('button[type="submit"][name="add"]'); if(!b||!ready){return;} e.preventDefault(); e.stopImmediatePropagation(); var v=B.shirt.variants[colourNow()+'|'+sizeNow()]; if(!v||!v.ok){return;} b.disabled=true; nftPos().then(function(pos){ var items=[{id:n.id,quantity:1,properties:{}},{id:v.id,quantity:1,properties:{'_shirt_theme':design,'_shirt_colour':colourNow(),'_shirt_size':sizeNow(),'_shirt_title':n.title,'_shirt_nft':String(pos)}}]; return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})}); }).then(function(r){ if(!r.ok){throw 0;} window.location.href='/cart'; }).catch(function(){ b.disabled=false; }); },true); }
  fetch('/products/'+encodeURIComponent(h)+'?view=nft-data',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(d){
    if(!d||!d.ok){return;} n=d; document.body.classList.add('sc-studio-on');
    buildDesignPicker(); applyColourRules(); price(); paintAll(); hookAdd(); ready=true;
    document.addEventListener('change',function(e){ if(e.target.matches&&e.target.matches('variant-selects input[type=radio]')){ setTimeout(function(){ price(); if(e.target.name.indexOf('Colour')===0){ paintAll(); } },50); } });
    /* Dawn re-renders the price block on variant change; keep the bundle price on it. */
    var pr=document.querySelector('.price'); if(pr&&window.MutationObserver){ var busy=false; new MutationObserver(function(){ if(busy){return;} busy=true; setTimeout(function(){ price(); busy=false; },0); }).observe(pr.parentNode,{childList:true,subtree:true}); }
  }).catch(function(){});
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SC Your T-shirt",
  "settings": [
    { "type": "paragraph", "content": "Fills the NFT Shirt page with the shopper's artwork when the link carries ?nft=<artwork handle>: the three designs on the chosen colour as the pictures, a Choose your design picker, the bundle price, and Add to cart adds both." }
  ]
}
{% endschema %}
