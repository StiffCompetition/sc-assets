{%- comment -%}
  SC PRINT PREVIEW (26 Oct 2026). Live samples of the three approved NFT shirt designs and the NFT poster, drawn in the page
  from the approved layouts (same proportions as the shirt-maker print files: 304.5 x 406 mm print box, 23 cm block, Rajdhani Bold,
  logo at 38.7 cm; poster 3:4 with the artwork in a black border, name, number, logo and owner footnote).
  Every sample shows the chosen artwork and YOUR NAME HERE where the owner's first name is printed.
  Adds window.scPreview(kind, art, title, extra) -> html and window.scDesignPicker(selectEl, art, title, extra) -> repaint(art, title, extra).
  kinds: owner, stats, tag, poster. extra: { character: 'Major Wood', stats: [rigidity, innuendo, friction, girth] }.
{%- endcomment -%}
{%- unless sc_print_preview_loaded -%}
{%- assign sc_print_preview_loaded = true -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@700&display=swap">
<style>
.scp{container-type:inline-size;position:relative;width:100%;overflow:hidden;font-family:Rajdhani,'Arial Narrow',Arial,sans-serif;font-weight:700;line-height:1;text-transform:uppercase;border-radius:4px;}
.scp *{box-sizing:border-box;}
.scp--shirt{aspect-ratio:3596/4795;background:#1f2326;color:#f5f5f0;}
.scp__fit{display:inline-block;vertical-align:top;line-height:1;white-space:nowrap;letter-spacing:.06em;}
.scp__row{display:block;white-space:nowrap;overflow:hidden;font-size:0;line-height:0;}
.scp__y{color:#fef200;}
.scp__blk{position:absolute;left:12.22cqw;top:0;width:75.56cqw;}
.scp__art{position:relative;width:100%;aspect-ratio:1/1;background:#f5f5f0;}
.scp__art img{position:absolute;inset:1.15cqw;width:calc(100% - 2.3cqw);height:calc(100% - 2.3cqw);object-fit:cover;display:block;}
.scp__art .scp__ph{position:absolute;inset:1.15cqw;background:#cfd3d8;color:#555;display:flex;align-items:center;justify-content:center;font-size:4cqw;letter-spacing:.06em;}
.scp__logo{position:absolute;left:22.8cqw;width:54.4cqw;top:112.76cqw;display:block;}
.scp--stats .scp__art{position:absolute;left:12.55cqw;top:32cqw;width:35.48cqw;}
.scp--stats .scp__art img,.scp--stats .scp__art .scp__ph{inset:0.98cqw;width:calc(100% - 1.96cqw);height:calc(100% - 1.96cqw);}
.scp--stats .scp__bars{position:absolute;left:51.97cqw;top:32cqw;width:35.48cqw;}
.scp--stats .scp__bar{position:relative;height:8.87cqw;}
.scp--stats .scp__bar i{position:absolute;left:0;top:1.15cqw;font-style:normal;font-size:3.1cqw;letter-spacing:.1em;}
.scp--stats .scp__bar b{position:absolute;right:0;top:0.75cqw;font-size:4cqw;color:#fef200;letter-spacing:.04em;}
.scp--stats .scp__bar em{position:absolute;left:0;right:0;top:4.76cqw;height:1.8cqw;background:#464a4e;}
.scp--stats .scp__bar em span{position:absolute;left:0;top:0;bottom:0;background:#fef200;}
.scp--stats .scp__own{position:absolute;left:12.22cqw;width:75.56cqw;top:71.75cqw;}
.scp--tag .scp__tg{position:absolute;left:51.64cqw;top:23cqw;width:32.2cqw;height:60.4cqw;border-radius:5.26cqw;background:linear-gradient(90deg,#b2b5ba,#d8dbe0 50%,#b2b5ba);box-shadow:inset 0 0 0 .35cqw #696e74,inset 0 0 0 .5cqw #ebeef2;color:#1e2125;text-align:center;}
.scp--tag .scp__tg:before{content:"";position:absolute;left:50%;top:4.6cqw;width:3.3cqw;height:3.3cqw;margin-left:-1.65cqw;border-radius:50%;background:#1f2326;box-shadow:0 0 0 .3cqw #6e7278;}
.scp--tag .scp__ch{position:absolute;left:50cqw;top:3cqw;width:35.5cqw;height:21cqw;border:.65cqw dotted #9a9fa6;border-bottom:0;border-radius:50% 50% 0 0/70% 70% 0 0;}
.scp--tag .scp__tg .scp__row{position:absolute;left:3.2cqw;width:25.8cqw;}
.scp--tag .scp__tg .scp__fit{text-shadow:.12cqw .12cqw 0 #ebeef2;}
.scp--tag .scp__rl{position:absolute;left:3.9cqw;right:3.9cqw;top:15.6cqw;height:.3cqw;background:#6e7278;}
.scp--tag .scp__qr{position:absolute;left:3.2cqw;top:36.5cqw;width:25.8cqw;height:25.8cqw;background:#fff;padding:.5cqw;}
.scp--tag .scp__qr i{display:block;width:100%;height:100%;background-image:repeating-conic-gradient(#111 0 25%,#fff 0 50%);background-size:2.4cqw 2.4cqw;}
.scp--poster{aspect-ratio:3/4;background:#fef200;color:#141414;text-align:center;}
.scp--poster.scp--off{background:#f5f5f0;}
.scp--poster .scp__art{position:absolute;left:6.89cqw;top:6.11cqw;width:86.22cqw;background:#141414;}
.scp--poster .scp__art img,.scp--poster .scp__art .scp__ph{inset:.56cqw;width:calc(100% - 1.12cqw);height:calc(100% - 1.12cqw);}
.scp--poster .scp__n1{position:absolute;left:0;right:0;top:95.85cqw;font-size:4.07cqw;letter-spacing:.14em;}
.scp--poster .scp__n2{position:absolute;left:0;right:0;top:101.8cqw;font-size:1.8cqw;letter-spacing:.12em;}
.scp--poster .scp__logo{left:6.89cqw;width:86.22cqw;top:106cqw;filter:brightness(0);}
.scp--poster .scp__fn{position:absolute;left:0;right:0;top:129.4cqw;font-size:1.69cqw;letter-spacing:.04em;text-transform:none;font-weight:600;}
.scp-cap{display:block;font-size:12px;line-height:1.3;margin:6px 0 0;opacity:.8;text-align:center;}
.scp-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0 0 4px;}
.scp-card{display:block;padding:0;margin:0;border:2px solid rgba(var(--color-foreground),.2);background:transparent;color:inherit;font:inherit;cursor:pointer;text-align:center;}
.scp-card[aria-pressed="true"]{border-color:rgb(var(--color-foreground));box-shadow:0 0 0 1px rgb(var(--color-foreground));}
.scp-card .scp{border-radius:0;}
.scp-card span.scp-nm{display:block;font-size:12px;line-height:1.25;padding:6px 4px;font-weight:600;}
@media (max-width:480px){.scp-cards{gap:6px;}}
</style>
<script>
(function(){
  if(window.scPreview){return;}
  var LOGO={{ 'sc-logo-light.png' | asset_url | json }};
  var NAME='YOUR NAME HERE';
  function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function art(a,cls){return '<div class="scp__art'+(cls?' '+cls:'')+'">'+(a?'<img src="'+esc(a)+'" alt="" loading="lazy">':'<span class="scp__ph">Your artwork</span>')+'</div>';}
  /* One line of text sized to fill its row, like the print file: width first, then a cap on the height, then the letters are spread. */
  function row(html,maxCqw,tr,style){return '<span class="scp__row"'+(style?' style="'+style+'"':'')+'><span class="scp__fit" data-max="'+(maxCqw||'')+'" data-tr="'+(tr==null?.06:tr)+'">'+html+'</span></span>';}
  var WORDING={'major wood':["'S ARTWORK IS AT FULL ATTENTION,","MAJOR WOOD IS UP AND STAYING UP"],'rear admiral':["'S ARTWORK HAS FINALLY DOCKED,","AND THE REAR ADMIRAL IS FIRST ABOARD!"],'hanky':["'S ARTWORK IS ABSOLUTELY SPOT ON,","AND HAMMERIN' HANKY NAILED IT!"],'grip':["'S ARTWORK IS HARD TO LET GO OF,","AND THE GRIP IS HOLDING ON TIGHT!"],'willy':["'S ARTWORK IS HARD TO PIN DOWN,","AND SLICK WILLY IS JUST AS SLIPPERY!"],'python':["'S ARTWORK IS A FEAST FOR THE EYES,","THE VELVET PYTHON LICKS HIS LIPS!"]};
  function wording(c){c=String(c||'').toLowerCase();for(var k in WORDING){if(c.indexOf(k)>-1){return WORDING[k];}}return ["'S ARTWORK, ONE OF ONE,","MADE FOR ITS OWNER"];}
  var STAT_NAMES=['RIGIDITY','INNUENDO','FRICTION','GIRTH'];
  window.scPreview=function(kind,a,title,extra){
    extra=extra||{};var t=esc(String(title||'YOUR ARTWORK').toUpperCase());
    if(kind==='owner'){var w=wording(extra.character);
      return '<div class="scp scp--shirt scp--owner"><div class="scp__blk">'+art(a)+'<div style="height:1.64cqw"></div>'+row(t)+'<div style="height:.98cqw"></div>'+row('ONE OF ONE &middot; DIGITAL ARTWORK',3.0,.06)+'<div style="height:5.58cqw"></div>'+row('<span class="scp__y">'+NAME+'</span>'+esc(w[0]))+'<div style="height:1.97cqw"></div>'+row(esc(w[1]))+'</div><img class="scp__logo" src="'+LOGO+'" alt=""></div>';}
    if(kind==='stats'){var st=extra.stats||[];
      return '<div class="scp scp--shirt scp--stats">'+art(a)+'<div class="scp__bars">'+STAT_NAMES.map(function(n,i){var v=st[i]==null?null:Math.max(0,Math.min(100,parseInt(st[i],10)||0));return '<div class="scp__bar"><i>'+n+'</i><b>'+(v==null?'&ndash;':v)+'</b><em><span style="width:'+(v==null?0:v)+'%"></span></em></div>';}).join('')+'</div><div class="scp__own">'+row('<span class="scp__y">'+NAME+'</span> OWNS THIS DIGITAL ARTWORK')+'</div><img class="scp__logo" src="'+LOGO+'" alt=""></div>';}
    if(kind==='tag'){
      return '<div class="scp scp--shirt scp--tag"><div class="scp__ch"></div><div class="scp__tg">'+row('STIFF COMPETITION',3.8,.06,'top:11.2cqw')+'<span class="scp__rl"></span>'+row(NAME,8.6,.06,'top:19cqw')+row('OWNS '+t,3.6,.06,'top:28.6cqw')+row('DIGITAL ARTWORK',2.9,.06,'top:32.2cqw;left:6.2cqw;width:19.8cqw')+'<div class="scp__qr"><i></i></div></div></div>';}
    return '<div class="scp scp--poster" data-poster>'+art(a)+'<div class="scp__n1">'+esc(String(extra.character||'').toUpperCase()||t)+'</div><div class="scp__n2">'+(extra.character?t:'')+'</div><img class="scp__logo" src="'+LOGO+'" alt=""><div class="scp__fn">'+NAME+' owns this original digital artwork on the blockchain</div></div>';
  };
  /* Fit every text row to its width (and height cap), as the print file does. */
  function fitOne(el){
    var box=el.parentNode;var W=box.clientWidth;if(!W){return;}
    var cq=el.closest('.scp').clientWidth/100;var tr=parseFloat(el.getAttribute('data-tr'))||0;
    el.style.fontSize='100px';el.style.letterSpacing=(tr*100)+'px';
    var w=el.getBoundingClientRect().width-tr*100;if(!w){return;}
    var fs=100*W/w;var max=parseFloat(el.getAttribute('data-max'));
    if(max&&fs>max*cq){fs=max*cq;}
    el.style.fontSize=fs+'px';el.style.letterSpacing=(tr*fs)+'px';
    var w2=el.getBoundingClientRect().width-tr*fs;var n=el.textContent.length;
    if(n>1&&w2<W-1){el.style.letterSpacing=(tr*fs+(W-w2)/(n-1))+'px';}
  }
  function fitAll(root){(root||document).querySelectorAll('.scp__fit').forEach(fitOne);}
  function colour(p){var img=p.querySelector('img');if(!img){return;}
    var im=new Image();im.crossOrigin='anonymous';
    im.onload=function(){try{var c=document.createElement('canvas');c.width=c.height=32;var x=c.getContext('2d');x.drawImage(im,0,0,32,32);var d=x.getImageData(0,0,32,32).data,n=0,g=0;
      for(var i=0;i<32;i++){[[i,0],[i,31],[0,i],[31,i]].forEach(function(q){var o=(q[1]*32+q[0])*4,r=d[o]/255,gg=d[o+1]/255,b=d[o+2]/255,mx=Math.max(r,gg,b),mn=Math.min(r,gg,b),s=mx?(mx-mn)/mx:0,h=0;
        if(mx!==mn){h=mx===r?(gg-b)/(mx-mn)%6:mx===gg?(b-r)/(mx-mn)+2:(r-gg)/(mx-mn)+4;h=(h*60+360)%360;}
        n++;if(s>.35&&mx>.35&&h>=50&&h<=150){g++;}});}
      p.classList.toggle('scp--off',g/n>.4);}catch(e){}};
    im.src=img.getAttribute('src');}
  function after(root){fitAll(root);(root||document).querySelectorAll('[data-poster]').forEach(colour);}
  var ro=window.ResizeObserver?new ResizeObserver(function(es){es.forEach(function(e){fitAll(e.target);});}):null;
  function watch(root){if(ro){(root||document).querySelectorAll('.scp').forEach(function(p){ro.observe(p);});}}
  window.scPreviewPaint=function(root){after(root);watch(root);};
  if(document.fonts&&document.fonts.ready){document.fonts.ready.then(function(){fitAll();});}
  window.addEventListener('load',function(){fitAll();});
  var KIND={registered_owner:'owner',brag_stats:'stats',dog_tag:'tag'};
  var NAMES={registered_owner:'Registered owner',brag_stats:'Brag stats',dog_tag:'Pocket dog tag'};
  window.scDesignPicker=function(sel,a,title,extra){
    if(!sel){return null;}
    var box=sel.parentNode.querySelector('.scp-cards');
    if(!box){box=document.createElement('div');box.className='scp-cards';sel.parentNode.insertBefore(box,sel);
      sel.style.display='none';
      box.addEventListener('click',function(e){var b=e.target.closest('.scp-card');if(!b){return;}sel.value=b.getAttribute('data-v');sel.dispatchEvent(new Event('change',{bubbles:true}));mark();});
      sel.addEventListener('change',mark);}
    var cur={a:a,t:title,x:extra};
    function mark(){box.querySelectorAll('.scp-card').forEach(function(b){b.setAttribute('aria-pressed',String(sel.value===b.getAttribute('data-v')));});}
    function paint(){box.innerHTML=[].map.call(sel.options,function(o){var k=KIND[o.value]||'owner';return '<button type="button" class="scp-card" data-v="'+esc(o.value)+'" aria-pressed="'+(sel.value===o.value)+'">'+window.scPreview(k,cur.a,cur.t,cur.x)+'<span class="scp-nm">'+esc(NAMES[o.value]||o.text)+'</span></button>';}).join('');window.scPreviewPaint(box);}
    paint();
    return function(na,nt,nx){cur.a=na;cur.t=nt;cur.x=nx;paint();};
  };
})();
</script>
{%- endunless -%}
