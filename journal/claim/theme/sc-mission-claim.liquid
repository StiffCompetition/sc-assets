function dl(cv,m){cv.toBlob(function(b){var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='stiff-competition-mission-'+(m<10?'0':'')+m+'.png';document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove()},500)},'image/png')}
