{% raw %}
<style>
@font-face{font-family:Bangers;src:url(https://raw.githubusercontent.com/StiffCompetition/sc-assets/271deb634d821d78f6d086fea799592a537d5ee8/journal/claim/Bangers.ttf);font-display:swap}@font-face{font-family:Oswald;src:url(https://raw.githubusercontent.com/StiffCompetition/sc-assets/271deb634d821d78f6d086fea799592a537d5ee8/journal/claim/Oswald.ttf);font-weight:200 700;font-display:swap}
.rte{display:none!important}
#scm{max-width:1100px;margin:0 auto;font-family:Oswald,'Arial Narrow',sans-serif;color:#111}
#scm *{box-sizing:border-box}
#scm .hd{background:#fff;border:6px solid #111;box-shadow:8px 8px 0 #111;padding:22px 18px;text-align:center;margin-bottom:26px}
#scm .hd h2{font-family:Bangers,Impact,sans-serif;font-size:clamp(34px,7vw,64px);letter-spacing:2px;margin:0 0 6px;line-height:1;color:#111}
#scm .hd p{margin:0 auto;max-width:640px;font-size:17px;line-height:1.35;font-weight:500}
#scm .strip{display:flex;gap:4px;justify-content:center;margin:14px 0 4px;flex-wrap:nowrap}
#scm .strip svg{width:clamp(18px,5.6vw,34px);height:auto}
#scm .cnt{font-weight:700;letter-spacing:3px;font-size:14px}
#scm .login{background:#ed1c24;color:#fff;border:6px solid #111;box-shadow:8px 8px 0 #111;padding:22px;text-align:center;margin-bottom:26px}
#scm .login b{display:block;font-family:Bangers,Impact,sans-serif;font-size:34px;letter-spacing:2px;margin-bottom:8px;font-weight:400}
#scm .btn{display:inline-block;background:#ffc400;color:#111;border:5px solid #111;box-shadow:5px 5px 0 #111;font:700 20px/1 Oswald,sans-serif;letter-spacing:3px;padding:14px 22px;text-decoration:none;cursor:pointer;text-transform:uppercase;margin:6px 6px 0 0}
#scm .btn:active{transform:translate(3px,3px);box-shadow:2px 2px 0 #111}
#scm .btn.alt{background:#fff}
#scm .btn.go{background:#7cc02f}
#scm .btn[disabled]{opacity:.55;cursor:wait}
#scm .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
@media(min-width:700px){#scm .grid{grid-template-columns:repeat(4,1fr)}}
#scm .tile{position:relative;border:5px solid #111;box-shadow:6px 6px 0 #111;background:#fff;cursor:pointer;padding:0;text-align:left;font:inherit;overflow:hidden;display:block;width:100%}
#scm .tile .top{padding:10px 70px 6px 10px;color:#fff;background:var(--c);min-height:92px}
#scm .tile .mn{font-family:Bangers,Impact,sans-serif;font-size:26px;letter-spacing:2px;line-height:1;text-shadow:2px 2px 0 #111}
#scm .tile .ph{font-weight:700;font-size:12px;letter-spacing:1.5px;line-height:1.25;margin-top:6px;text-shadow:1px 1px 0 #111}
#scm .tile .st{padding:8px 10px;font-weight:700;letter-spacing:2px;font-size:14px;background:#fff;display:flex;justify-content:space-between;align-items:center}
#scm .tile.done .st{background:#111;color:#ffc400}
#scm .tile img{position:absolute;right:-6px;top:10px;width:64px;height:64px;border-radius:50%;border:4px solid #111;background:#fff;object-fit:cover;object-position:top}
#scm .ov{position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:99999;display:none;overflow:auto;padding:14px}
#scm .ov.on{display:block}
#scm .box{max-width:560px;margin:0 auto;background:#fff;border:6px solid #111;box-shadow:8px 8px 0 #111;padding:14px;position:relative}
#scm .x{position:absolute;right:8px;top:8px;width:42px;height:42px;border:4px solid #111;background:#ed1c24;color:#fff;font:700 22px/1 Oswald,sans-serif;cursor:pointer;z-index:2}
#scm canvas{width:100%;height:auto;display:block;border:4px solid #111;background:#ddd}
#scm .nm{display:flex;gap:8px;align-items:center;margin:12px 0 4px;flex-wrap:wrap}
#scm .nm label{font-weight:700;letter-spacing:2px;font-size:14px}
#scm .nm input{flex:1;min-width:140px;border:4px solid #111;padding:10px;font:700 18px Oswald,sans-serif;letter-spacing:1px;text-transform:uppercase}
#scm .rw{background:#fff4c2;border:5px dashed #111;padding:12px;margin:12px 0;line-height:1.35}
#scm .rw b{font-family:Bangers,Impact,sans-serif;font-size:26px;letter-spacing:2px;font-weight:400;display:block}
#scm .code{display:inline-block;background:#111;color:#ffc400;font:700 24px/1 Oswald,sans-serif;letter-spacing:3px;padding:10px 14px;margin:6px 8px 6px 0;user-select:all}
#scm .msg{font-weight:700;letter-spacing:1px;margin:8px 0;min-height:22px}
#scm .note{font-size:14px;margin-top:14px;text-align:center;opacity:.8}
@media print{body *{visibility:hidden}#scm #scprint,#scm #scprint *{visibility:visible}#scm #scprint{position:absolute;left:0;top:0;width:100%}}
</style>
<div id="scm"><div id="scroot"></div>
<div class="ov" id="scov"><div class="box"><button class="x" id="scx" aria-label="Close">X</button><div id="scbox"></div></div></div>
<img id="scprint" alt="" style="display:none"></div>
