.scc{--ink:#15181c;--paper:#f4f0e6;--rule:#b9ad8f;--pop:#ed1c24;--sans:'Inter','Helvetica Neue',Helvetica,Arial,sans-serif;color:var(--ink);font-family:var(--sans);padding:20px 16px 32px;background:#fff}
.scc *{box-sizing:border-box}
.scc__stage{max-width:460px;margin:0 auto}
.scc__msg{border:2px solid var(--ink);padding:26px 18px;text-align:center}
.scc__msgt{font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:20px;margin:0 0 8px}
.scc__msgp{font-size:14px;line-height:1.55;margin:0}
.scc__actions{display:flex;flex-direction:column;gap:10px;margin-top:16px}
.scc__btn{display:flex;align-items:center;justify-content:center;width:100%;padding:14px 22px;border:2px solid var(--pop);background:var(--pop);color:#fff !important;text-decoration:none !important;font-weight:700;font-size:13px;line-height:1.2;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
.scc__btn--ghost{background:transparent;border-color:var(--ink);color:var(--ink) !important}
/* SCREEN CERTIFICATE: same layout as the Certificate of Deployment email */
.scw{background:var(--paper);border:3px solid var(--ink);padding:4px;color:var(--ink);text-align:center;font-family:var(--sans)}
.scw__i{border:1px solid var(--ink);padding:8px}
.scw__band{background:var(--c1);color:var(--paper);padding:10px 10px 14px}
.scw__top{font-weight:700;font-size:clamp(8px,2.5vw,9px);letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}
.scw__title{font-weight:700;font-size:22px;line-height:1.15;letter-spacing:1.5px;text-transform:uppercase;margin:8px 0 10px}
.scw__heroes{display:flex;flex-wrap:wrap;justify-content:center;gap:14px 0;max-width:330px;margin:0 auto}
.scw__hero{width:33.33%;padding:0 5px}
.scw__hero.one{width:100%}
.scw__ring{margin:0 auto;width:var(--m);height:var(--m);border-radius:50%;border:4px solid var(--paper);background:#fff;overflow:hidden}
.scw__ring img{width:100%;height:100%;display:block;object-fit:cover}
.scw__cn{font-weight:700;font-size:11px;letter-spacing:1px;line-height:1.15;text-transform:uppercase;padding-top:6px}
.scw__hero.one .scw__cn{font-size:20px;letter-spacing:2px;padding-top:8px}
.scw__ph{font-size:14px;line-height:1.3;padding-top:2px}
.scw__mono{width:88px;display:block;margin:6px auto 0}
.scw__tag{font-weight:700;font-size:17px;letter-spacing:1.5px;text-transform:uppercase;padding-top:12px;white-space:nowrap}
.scw__cust{padding:18px 0}
.scw__txt{font-size:11px;line-height:1.6;letter-spacing:.5px;text-transform:uppercase}
.scw__sealed{font-size:10px;letter-spacing:0;text-transform:uppercase;white-space:nowrap}
.scw__nrow{display:flex;align-items:center;justify-content:center}
.scw__nrow .side{flex:0 0 var(--sw);display:block !important;font-size:0;line-height:0}
.scw__nrow .side img{width:var(--ss);height:var(--ss);display:block}
.scw__name{flex:0 1 auto;font-weight:700;text-transform:uppercase;line-height:1.05;padding:6px 8px 4px;white-space:nowrap}
.scw__man{border:1.5px solid var(--ink);background:#fbf8f1;text-align:left}
.scw__mh{background:var(--ink);color:#fff;display:flex;justify-content:space-between;align-items:center;padding:5px 10px}
.scw__mh b{font-size:13px;letter-spacing:2.5px;text-transform:uppercase;line-height:18px;white-space:nowrap}
.scw__mh span{border:1px solid var(--paper);color:var(--paper);font-weight:700;font-size:8px;letter-spacing:.8px;padding:0 6px;line-height:14px;white-space:nowrap}
.scw__row{display:flex;align-items:center;margin:0 10px;padding:8px 0;border-top:1px dotted var(--rule);font-weight:700;text-transform:uppercase}
.scw__row:first-of-type{border-top:0}
.scw__row .n{width:26px;font-size:14px}
.scw__row .d{font-size:12px;letter-spacing:.5px;white-space:nowrap;padding-right:6px}
.scw__row .u{flex:1;text-align:right;font-size:10px;letter-spacing:.8px}
.scw__logo{width:118px;display:block;margin:16px auto 8px}
