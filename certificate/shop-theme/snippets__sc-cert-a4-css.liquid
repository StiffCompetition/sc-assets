/* A4 PRINT CERTIFICATE: one fixed layout for every order, one page */
.c4{--ink:#15181c;--paper:#f3efe6;--rule:#b9b2a3;width:210mm;height:297mm;box-sizing:border-box;padding:7mm;background:#fff;font-family:'Inter','Helvetica Neue',Helvetica,Arial,sans-serif;color:var(--ink)}
.c4 *{box-sizing:border-box}
.c4__o{height:100%;border:2.2mm solid var(--ink);padding:1.6mm;background:var(--paper)}
.c4__i{height:100%;border:.4mm solid var(--ink);padding:6mm;display:flex;flex-direction:column}
.c4__band{background:var(--c1);color:var(--paper);text-align:center;height:112mm;flex:0 0 112mm;padding:5mm 6mm 4mm;display:flex;flex-direction:column;overflow:hidden}
.c4__hz{flex:1;display:flex;flex-direction:column;justify-content:center}
.c4__top{font-weight:700;font-size:3.1mm;letter-spacing:.5mm;text-transform:uppercase;white-space:nowrap}
.c4__title{font-weight:700;font-size:11.5mm;line-height:1.1;letter-spacing:.8mm;text-transform:uppercase;margin:3mm 0 5mm}
.c4__heroes{display:flex;flex-wrap:wrap;justify-content:center;gap:4mm 2mm;max-width:156mm;margin:0 auto}
.c4__hero{width:50mm;text-align:center}
.c4__hero.one{width:auto}
.c4__ring{margin:0 auto;width:var(--m);height:var(--m);border-radius:50%;border:1.6mm solid var(--paper);background:#fff;overflow:hidden}
.c4__ring img{width:100%;height:100%;display:block;object-fit:cover}
.c4__cn{font-weight:700;text-transform:uppercase;letter-spacing:.6mm;line-height:1.15;margin-top:2.5mm}
.c4__ph{font-size:5mm;margin-top:1mm}
.c4__mono{width:44mm;display:block;margin:2mm auto 0}
.c4__tag{font-weight:700;font-size:7.5mm;letter-spacing:.6mm;text-transform:uppercase;margin-top:5mm}
.c4__cust{flex:0 0 68mm;height:68mm;display:flex;flex-direction:column;justify-content:center;text-align:center;overflow:hidden}
.c4__txt{font-size:4mm;line-height:1.6;letter-spacing:.2mm;text-transform:uppercase}
.c4__nrow{display:flex;align-items:center;justify-content:center;margin:2mm 0}
.c4__nrow .side{flex:0 0 var(--sw);display:block !important;font-size:0;line-height:0}
.c4__nrow .side img{width:var(--sw);display:block}
.c4__name{font-weight:700;text-transform:uppercase;letter-spacing:1mm;line-height:1;padding:0 4mm}
.c4__mz{flex:0 0 54mm;height:54mm;overflow:hidden}
.c4__man{border:.35mm solid var(--ink);background:#fbf8f1}
.c4__mh{background:var(--ink);color:#fff;display:flex;justify-content:space-between;align-items:center;padding:2.4mm 4mm}
.c4__mh b{font-size:4.6mm;letter-spacing:.9mm;text-transform:uppercase}
.c4__mh span{border:.3mm solid var(--paper);color:var(--paper);font-weight:700;font-size:3mm;letter-spacing:.3mm;padding:.8mm 2.4mm}
.c4__row{display:flex;align-items:center;margin:0 4mm;height:var(--rh);border-top:.3mm dotted var(--rule);font-weight:700;text-transform:uppercase}
.c4__row:first-of-type{border-top:0}
.c4__row .n{width:10mm;font-size:calc(var(--rf) * 1.15)}
.c4__row .d{flex:1;font-size:var(--rf);letter-spacing:.2mm}
.c4__row .u{font-size:calc(var(--rf) * .8);letter-spacing:.3mm;color:var(--ink)}
.c4__lz{flex:1;display:flex;align-items:center;justify-content:center}
.c4__logo{width:50mm;display:block}

.c4.dense .c4__title{font-size:9mm;margin:2mm 0 3.5mm}
.c4.dense .c4__cn{margin-top:2mm}
.c4.dense .c4__mh{padding:1.8mm 4mm}
.c4.dense .c4__band{padding:5mm 6mm 6mm}
.c4.dense .c4__heroes{gap:3mm 2mm}
